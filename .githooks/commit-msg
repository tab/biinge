#!/usr/bin/env bash
# Enforces the commit rules in CLAUDE.md that no linter can see: Conventional
# Commits with a scope, and no AI attribution anywhere in the message
set -euo pipefail

file="$1"
status=0

# Content git generates or rewrites, none of which the author is writing here
subject="$(grep -vE '^#' "$file" | sed '/^[[:space:]]*$/d' | head -1 || true)"
case "$subject" in
  Merge\ *|Revert\ *|fixup!*|squash!*|"") exit 0 ;;
esac

if ! grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9.-]+\): [A-Z]' <<<"$subject"; then
  echo "commit-msg: the subject needs a scoped Conventional Commit, capitalized after the colon"
  echo "  got:  $subject"
  echo "  want: fix(api): Return the not-found sentinel without logging"
  status=1
fi

if grep -qE '\.$' <<<"$subject"; then
  echo "commit-msg: drop the trailing period from the subject"
  status=1
fi

# CLAUDE.md: no Co-Authored-By trailer and no mention of AI tooling anywhere
if grep -viE '^#' "$file" | grep -qiE '\b(claude|anthropic|copilot|chatgpt|cursor\.so|codex)\b|claude-session:|🤖'; then
  echo "commit-msg: remove the AI tooling attribution"
  grep -vE '^#' "$file" | grep -inE '\b(claude|anthropic|copilot|chatgpt|cursor\.so|codex)\b|claude-session:|🤖' | sed 's/^/  /'
  status=1
fi

[ "$status" -ne 0 ] && echo "commit-msg: see CLAUDE.md > Commits"
exit "$status"
