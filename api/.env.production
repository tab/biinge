LOG_LEVEL=info

APP_NAME=biinge

CLIENT_URL=

DATABASE_DSN=postgres://postgres:postgres@postgres:5432/biinge-production?sslmode=disable

# public third-party endpoints, not secrets — the credentials come from the deploy environment
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token

# both empty turn Jellyfin off; the deploy environment sets them
JELLYFIN_BASE_URL=
JELLYFIN_TOKEN_KEY=

SENTRY_DSN=
