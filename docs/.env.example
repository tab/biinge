# Copy this to .env (gitignored) and set the values for the site you deploy.
# CI reads the same names from repository variables, so the domain never has to
# live in the repo. Both are optional: without them a local build still works,
# it just leaves the canonical and Open Graph URLs relative.

# The site's own origin, no trailing slash. Feeds astro.config.mjs, the canonical
# link, the Open Graph tags, and the CNAME the Pages workflow writes.
SITE_URL=https://example.com

# Default target of the API playground on /docs/api. Origin only — the endpoint
# paths already carry /api/v1. Falls back to http://localhost:8080 when unset.
PUBLIC_API_BASE_URL=https://api.example.com
