---
interface Props {
  code: string;
  label?: string;
}

const { code, label = "terminal" } = Astro.props;
const lines = code.split("\n");

function esc(text: string): string {
  return text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function highlight(line: string): string {
  const trimmed = line.trimStart();

  if (trimmed.startsWith("#")) {
    return `<span class="hl-comment">${esc(line)}</span>`;
  }

  return esc(line)
    .replace(
      /^(\s*)(docker|compose|make|git|go|cd|sudo|npm|curl|open|export|cp|mv|GO_ENV)(\s|$)/,
      '$1<span class="hl-cmd">$2</span>$3',
    )
    .replace(/(--[\w-]+)/g, '<span class="hl-flag">$1</span>');
}

const highlighted = lines.map(highlight).join("\n");
---

<div class="code-ide">
  <div class="code-titlebar">
    <div class="code-tab">
      <svg class="file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 17 10 11 4 5"/>
        <line x1="12" y1="19" x2="20" y2="19"/>
      </svg>
      <span class="tab-name">{label}</span>
    </div>
    <button class="copy-btn" aria-label="Copy code" title="Copy code">
      <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </button>
  </div>
  <div class="code-body">
    <pre><code set:html={highlighted} /></pre>
  </div>
</div>

<style>
  /* the site's dark surfaces in both themes, as a terminal stays dark */
  .code-ide {
    border-radius: 16px;
    overflow: hidden;
    background: #17171d;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .code-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px 0 16px;
    height: 40px;
    background: #131317;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .code-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #91919a;
    font-size: 0.8rem;
    font-family: var(--mono);
  }

  .file-icon {
    color: #6b6b74;
    flex-shrink: 0;
  }

  .tab-name {
    color: #c8c8c4;
  }

  .copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: #6b6b74;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }

  .copy-btn:hover {
    color: #f4f4f2;
    background: rgba(255, 255, 255, 0.06);
  }

  .copy-btn:active {
    background: rgba(255, 255, 255, 0.14);
  }

  .copy-btn.copied {
    color: #34c46f;
  }

  .check-icon {
    display: none;
  }

  .copy-btn.copied .copy-icon {
    display: none;
  }

  .copy-btn.copied .check-icon {
    display: block;
  }

  .code-body {
    display: flex;
    padding: 16px 0;
    overflow-x: auto;
  }

  pre {
    margin: 0;
    flex: 1;
    min-width: 0;
    padding-left: 16px;
    padding-right: 16px;
  }

  code {
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: #f4f4f2;
  }

  :global(.hl-comment) { color: #6b6b74; font-style: italic; }
  :global(.hl-cmd) { color: #ff6b70; }
  :global(.hl-flag) { color: #eec01e; }
</style>
