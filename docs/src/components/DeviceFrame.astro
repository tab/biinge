---
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  // a dark section shows the dark screenshot whatever the page theme is
  fixedDark?: boolean;
}

const { name, alt, eager = false, fixedDark = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const loading = eager ? "eager" : "lazy";
---

<div class="device">
  <div class="device-screen">
    <!--
      src is set by the theme script rather than in the markup: two <img> tags
      with one hidden still downloads both files, and there are twenty frames
    -->
    <img
      data-screen
      data-light={`${base}screens/${name}-light.jpg`}
      data-dark={`${base}screens/${name}-dark.jpg`}
      data-fixed={fixedDark ? "dark" : undefined}
      alt={alt}
      width="1206"
      height="2622"
      loading={loading}
      decoding="async"
    />
  </div>
</div>

<style>
  .device {
    position: relative;
    width: 100%;
    padding: 7px; /* room for the bezel box-shadow */
  }

  /*
   * the screen carries the exact screenshot aspect ratio so object-fit never
   * crops the app's side margins; black bezel + titanium rail via box-shadow
   */
  .device-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 1206 / 2622;
    border-radius: 12% / 5.5%;
    border: 1px solid var(--screen-edge);
    overflow: hidden;
    background: #000;
    box-shadow:
      0 0 0 5px var(--bezel),
      0 0 0 6px var(--bezel-rail),
      var(--shadow-lg);
  }

  .device-screen img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
