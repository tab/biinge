---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer-inner">
    <a href={base} class="home" aria-label="biinge home">
      <img src={`${base}icon.png`} width="22" height="22" alt="" />
    </a>
    <nav class="links" aria-label="Footer">
      <a href={`${base}iphone/`}>iPhone</a>
      <a href={`${base}mac/`}>Mac</a>
      <a href={`${base}apple-tv/`}>Apple TV</a>
      <a href={`${base}about/`}>About</a>
      <a href={`${base}self-hosting/`}>Self-host</a>
      <a href={`${base}docs/api/`}>API</a>
      <a href="https://github.com/tab/biinge" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/tab/biinge/blob/master/LICENSE" target="_blank" rel="noopener">MIT License</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
  }

  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 44px clamp(20px, 5vw, 64px);
    font-family: var(--sans);
    font-size: 13.5px;
    color: var(--footer-text);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
  }

  .home img {
    display: block;
    border-radius: 6px;
    opacity: 0.9;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }

  .links a {
    color: var(--footer-text);
    text-decoration: none;
    transition: color 0.15s;
  }

  .links a:hover {
    color: var(--text);
    text-decoration: none;
  }
</style>
