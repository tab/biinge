---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  // the nav entry marked as the current page
  page?: "home" | "iphone" | "mac" | "tv" | "about";
  wide?: boolean;
  // set on pages that open with a dark hero the bar can sit over
  over?: boolean;
}

const { page, wide, over } = Astro.props;
const base = import.meta.env.BASE_URL;

// self-hosting and the API reference are reached from the footer
const links = [
  { label: "iPhone", href: `${base}iphone/`, key: "iphone" },
  { label: "Mac", href: `${base}mac/`, key: "mac" },
  { label: "Apple TV", href: `${base}apple-tv/`, key: "tv" },
  { label: "About", href: `${base}about/`, key: "about" },
];
---

<header class:list={["topbar", { over }]}>
  <input type="checkbox" id="mobile-toggle" class="mobile-toggle" aria-label="Toggle menu" />

  <div class:list={["topbar-inner", { wide }]}>
    <div class="topbar-left">
      <a href={`${base}`} class="logo">
        <img class="mark" src={`${base}icon.png`} width="28" height="28" alt="" aria-hidden="true" />
        <span class="brand-name">biinge</span>
      </a>

      <nav class="topbar-nav">
        {links.map((link) => (
          <a href={link.href} class:list={["nav-link", { active: page === link.key }]} aria-current={page === link.key ? "page" : undefined}>{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="topbar-right">
      <ThemeToggle />
      <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="github-cta">
        GitHub
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
      <label for="mobile-toggle" class="mobile-menu-btn">
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </label>
    </div>
  </div>

  <div class="mobile-menu">
    <!-- the collapsing row measures this wrapper, so the padding sits inside it -->
    <div class="mobile-menu-inner">
      <nav>
        {links.map((link) => (
          <a href={link.href} class:list={["mobile-link", { active: page === link.key }]} aria-current={page === link.key ? "page" : undefined}>{link.label}</a>
        ))}
        <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="mobile-link">GitHub</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s, border-color 0.3s;
  }

  /*
   * Over the hero the bar carries no ground of its own, so it borrows the
   * hero's palette until the page scrolls out from under it or the menu opens
   */
  .topbar.over:not(.is-stuck):not(:has(.mobile-toggle:checked)) {
    --text: #f4f4f2;
    --text-muted: rgba(255, 255, 255, 0.74);
    --bg: #101014;
    --border: rgba(255, 255, 255, 0.2);
    --nav-hover-bg: rgba(255, 255, 255, 0.12);
    --fill: rgba(255, 255, 255, 0.1);
    --fill-hover: rgba(255, 255, 255, 0.18);
    background: linear-gradient(180deg, rgba(16, 16, 20, 0.7) 0%, rgba(16, 16, 20, 0) 100%);
    /* from the border edge, or the gradient repeats a dark hairline into the transparent border */
    background-origin: border-box;
    border-bottom-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* the open menu is solid, or the dark Home hero muddies its lower links in light */
  .topbar:has(.mobile-toggle:checked) {
    background: var(--bg);
  }

  /*
   * Solid rather than half-frosted where the user asked for less transparency or
   * more contrast. Over the hero the bar keeps its own scrim, so it stays out
   */
  @media (prefers-reduced-transparency: reduce) {
    .topbar:not(.over),
    .topbar.is-stuck {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-contrast: more) {
    .topbar:not(.over),
    .topbar.is-stuck {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom-color: var(--text);
    }
  }

  .topbar-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .topbar-inner.wide {
    max-width: none;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-variation-settings: "wdth" 100, "wght" 640;
    font-size: 19px;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.028em;
  }

  .logo:hover {
    text-decoration: none;
  }

  .mark {
    border-radius: 7px;
    display: block;
    box-shadow: 0 0 0 1px var(--fill);
  }

  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-size: 14.5px;
    font-weight: 450;
    color: color-mix(in srgb, var(--text) 66%, transparent);
    text-decoration: none;
    padding: 7px 12px;
    border-radius: 8px;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link:active {
    background: var(--nav-hover-bg);
  }

  .nav-link.active {
    color: var(--text);
    font-weight: 600;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .github-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.12s;
  }

  .github-cta:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .github-cta:active {
    opacity: 0.7;
    transform: scale(0.97);
  }

  /* hidden at desktop widths so it never takes a tab stop the user can't act on */
  .mobile-toggle {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--fill);
    color: var(--text);
    cursor: pointer;
  }

  .mobile-menu-btn:active {
    background: var(--fill-hover);
  }

  .icon-close {
    display: none;
  }

  .mobile-toggle:checked ~ .topbar-inner .mobile-menu-btn .icon-menu {
    display: none;
  }

  .mobile-toggle:checked ~ .topbar-inner .mobile-menu-btn .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding: 12px clamp(20px, 5vw, 64px);
    gap: 2px;
  }

  .mobile-link {
    display: block;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }

  .mobile-link:hover {
    color: var(--text);
    background: var(--nav-hover-bg);
    text-decoration: none;
  }

  .mobile-link:active {
    color: var(--text);
    background: var(--nav-hover-bg);
    opacity: 0.7;
  }

  .mobile-link.active {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .topbar-nav {
      display: none;
    }

    .github-cta {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    /*
     * Visually hidden rather than display:none, so the checkbox keeps its tab
     * stop and Space opens the menu. The label beside it stays the visible hit
     * target, and wears the focus ring on the checkbox's behalf
     */
    .mobile-toggle {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .mobile-toggle:focus-visible ~ .topbar-inner .mobile-menu-btn {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 6px;
    }

    /*
     * Opens and closes along the same path: a row transition both ways, rather
     * than a keyframe in and a cut out. visibility trails the close so the links
     * leave the tab order only once they've finished collapsing
     */
    .mobile-menu {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      border-top: 1px solid transparent;
      transition: grid-template-rows 0.28s cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 0.18s ease, border-color 0.28s, visibility 0s linear 0.28s;
    }

    /*
     * The wrapper is the grid item, and carries no padding of its own: padding
     * on the item counts toward the row's minimum, which would leave the closed
     * menu holding a band of empty header
     */
    .mobile-menu-inner {
      min-height: 0;
      overflow: hidden;
    }

    .mobile-toggle:checked ~ .mobile-menu {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      border-top-color: var(--border);
      transition: grid-template-rows 0.28s cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 0.18s ease, border-color 0.28s, visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-toggle:checked ~ .mobile-menu {
      transition: none;
    }
  }
</style>
