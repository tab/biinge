---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  section?: "about" | "self-hosting" | "api";
  wide?: boolean;
}

const { section, wide } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "About", href: `${base}about/`, key: "about" },
];
---

<header class="topbar">
  <input type="checkbox" id="mobile-toggle" class="mobile-toggle" aria-label="Toggle menu" />

  <div class:list={["topbar-inner", { wide }]}>
    <div class="topbar-left">
      <a href={`${base}`} class="logo">
        <img class="mark" src={`${base}icon.png`} width="26" height="26" alt="" aria-hidden="true" />
        <span class="brand-name">biinge</span>
      </a>

      <nav class="topbar-nav">
        {links.map((link) => (
          <a href={link.href} class:list={["nav-link", { active: section === link.key }]}>{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="topbar-right">
      <ThemeToggle />
      <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="github-cta">
        GitHub
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
      <label for="mobile-toggle" class="mobile-menu-btn">
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </label>
    </div>
  </div>

  <div class="mobile-menu">
    <nav>
      {links.map((link) => (
        <a href={link.href} class:list={["mobile-link", { active: section === link.key }]}>{link.label}</a>
      ))}
      <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="mobile-link">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar-inner.wide {
    max-width: none;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-family: var(--heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    text-decoration: none;
  }

  .mark {
    border-radius: 7px;
    display: block;
    border: 1px solid var(--border);
  }

  .topbar-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 8px;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--text);
    font-weight: 600;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .github-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .github-cta:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .mobile-toggle {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
  }

  .icon-close {
    display: none;
  }

  .mobile-toggle:checked ~ .topbar-inner .mobile-menu-btn .icon-menu {
    display: none;
  }

  .mobile-toggle:checked ~ .topbar-inner .mobile-menu-btn .icon-close {
    display: block;
  }

  .mobile-menu {
    display: none;
    overflow: hidden;
    border-top: 1px solid var(--border);
  }

  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    padding: 12px 24px;
    gap: 2px;
  }

  .mobile-link {
    display: block;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }

  .mobile-link:hover {
    color: var(--text);
    background: var(--nav-hover-bg);
    text-decoration: none;
  }

  .mobile-link.active {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .topbar-inner {
      padding: 0 24px;
    }

    .topbar-nav {
      display: none;
    }

    .github-cta {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-toggle:checked ~ .mobile-menu {
      display: block;
      animation: slideDown 0.25s ease-out;
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
