---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <div class="eyebrow-label">Self-hosted movie &amp; TV tracker</div>
      <h1 class="title">
        Everything you watch,<br />
        <span class="title-accent">on your own server.</span>
      </h1>
      <p class="description">
        Keep separate want, watching, and watched lists across movies and TV.
        Episode-level progress, an Up&nbsp;Next queue, and watch stats - in a
        native iOS app backed by an API you run and a database you own.
      </p>
      <div class="actions">
        <a href={`${base}self-hosting/`} class="btn btn-primary">Self-host it</a>
        <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="btn btn-ghost">View on GitHub</a>
      </div>
      <div class="hint">Go + Postgres API &middot; native iOS app &middot; MIT licensed</div>
    </div>
    <div class="hero-visual">
      <div class="phone-duo">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 84px 56px 72px;
    max-width: 1160px;
    margin: 0 auto;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .hero-visual {
    display: flex;
    justify-content: flex-end;
  }

  .phone-duo {
    position: relative;
    width: 342px;
    max-width: 100%;
    aspect-ratio: 342 / 466;
  }

  .phone-duo :global(.device) {
    position: absolute;
  }

  /* back phone */
  .phone-duo :global(.device):first-child {
    left: 0;
    top: 30px;
    width: 54.5%;
    z-index: 1;
  }

  /* front phone */
  .phone-duo :global(.device):last-child {
    right: 0;
    top: 0;
    width: 59%;
    z-index: 2;
  }

  .title {
    font-family: var(--heading);
    font-weight: 700;
    font-size: 3.3rem;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 0 0 22px;
    color: var(--text);
  }

  .title-accent {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 4px;
    text-underline-offset: 7px;
  }

  .description {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 34px;
    flex-wrap: wrap;
  }

  .hint {
    margin-top: 24px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-visual {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 48px 22px;
    }

    .title {
      font-size: 2.3rem;
    }

    .description {
      font-size: 1.05rem;
    }
  }
</style>
