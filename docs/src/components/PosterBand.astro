---
const base = import.meta.env.BASE_URL;
---

<section class="band" style={`background-image: linear-gradient(90deg, rgba(0,0,0,0.92), rgba(0,0,0,0.45) 55%, rgba(0,0,0,0.82)), url(${base}screens/poster-wall.jpg)`}>
  <div class="container">
    <p class="band-quote">
      Every film and show you care about - <span>want</span>, <span>watching</span>,
      and <span>watched</span> - kept together, and kept yours.
    </p>
  </div>
</section>

<style>
  .band {
    background-size: cover;
    background-position: center 28%;
    padding: 96px 0;
  }

  .band-quote {
    max-width: 780px;
    font-family: var(--heading);
    font-size: 2rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .band-quote span {
    color: var(--gold);
  }

  @media (max-width: 768px) {
    .band {
      padding: 64px 0;
    }

    .band-quote {
      font-size: 1.4rem;
    }
  }
</style>
