---
import CodeBlock from "./CodeBlock.astro";

const base = import.meta.env.BASE_URL;

const snippet = `# clone, add a TMDB token, bring up the stack
git clone https://github.com/tab/biinge.git
cd biinge
docker compose up -d          # Postgres + Redis + API on :8080`;

const tags = ["Docker", "PostgreSQL", "Redis", "Go"];
---

<section class="cta">
  <div class="cta-glow"></div>
  <div class="cta-inner">
    <div class="cta-text">
      <div class="eyebrow-label">Your server, your data</div>
      <h2>Run it yourself in minutes.</h2>
      <p>
        No account on someone else's cloud. Bring up Postgres, Redis, and the
        API with one Compose command, point the app at it, and your watch
        history lives in a database you control.
      </p>
      <div class="cta-actions">
        <a href={`${base}self-hosting/`} class="btn btn-accent">Self-host guide <span>&rarr;</span></a>
        <a href="https://github.com/tab/biinge" target="_blank" rel="noopener" class="btn btn-ghostlight">GitHub</a>
      </div>
      <div class="cta-tags">
        {tags.map((t) => <span>{t}</span>)}
      </div>
    </div>
    <div class="cta-term">
      <CodeBlock code={snippet} label="quick start" />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: 88px 0;
    background: linear-gradient(150deg, #1a1620, #050506);
    border-top: 1px solid var(--border);
    color: #fafafa;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(620px 440px at 82% -5%, rgba(229, 72, 77, 0.2), transparent 60%),
      radial-gradient(560px 460px at 6% 105%, rgba(238, 192, 30, 0.12), transparent 60%);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 56px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .cta-text { min-width: 0; }

  .cta h2 {
    font-family: var(--heading);
    font-size: 2.6rem;
    line-height: 1.03;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin: 0 0 16px;
    color: #fff;
  }

  .cta p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #a89ba6;
    max-width: 460px;
    margin: 0 0 28px;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-ghostlight {
    background: transparent;
    color: #fafafa;
    border: 1.5px solid rgba(255, 255, 255, 0.22);
  }

  .btn-ghostlight:hover { border-color: rgba(255, 255, 255, 0.5); }

  .cta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .cta-tags span {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: #a89ba6;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .cta-term { position: relative; z-index: 1; min-width: 0; }

  @media (max-width: 900px) {
    .cta { padding: 60px 0; }

    .cta-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 0 22px;
    }

    .cta h2 { font-size: 2rem; }
  }
</style>
