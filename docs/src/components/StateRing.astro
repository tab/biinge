---
/*
 * The badge the app draws on every poster: hollow for want, a partial arc for
 * watching, solid for watched. Used as the page's bullet and section marker
 */
interface Props {
  state: "want" | "watching" | "watched";
  size?: number;
  animate?: boolean;
  delay?: number;
}

const { state, size = 16, animate = false, delay = 0 } = Astro.props;

const RADIUS = 13;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;

// watching sits mid-arc because that is what the state means - part of the way through
const fraction = { want: 0, watching: 0.55, watched: 1 }[state];
const offset = CIRCUMFERENCE * (1 - fraction);
---

<svg
  class:list={["ring", `is-${state}`, { animate }]}
  style={`--size:${size}px; --dash:${CIRCUMFERENCE}; --offset:${offset}; --delay:${delay}ms;`}
  viewBox="0 0 32 32"
  role="img"
  aria-label={state}
>
  <circle class="track" cx="16" cy="16" r={RADIUS} />
  {fraction > 0 && <circle class="arc" cx="16" cy="16" r={RADIUS} />}
  {state === "watched" && <circle class="core" cx="16" cy="16" r="6.5" />}
</svg>

<style>
  .ring {
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
    overflow: visible;
  }

  .track,
  .arc {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  .track {
    stroke: currentColor;
    opacity: 0.28;
  }

  .arc {
    stroke: currentColor;
    stroke-dasharray: var(--dash);
    stroke-dashoffset: var(--offset);
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }

  .core {
    fill: currentColor;
  }

  .is-want {
    color: var(--want);
  }

  .is-watching {
    color: var(--watching);
  }

  .is-watched {
    color: var(--watched);
  }

  /* the one choreographed moment: the badge fills itself as the section arrives */
  .animate .arc {
    stroke-dashoffset: var(--dash);
    transition: stroke-dashoffset 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay);
  }

  .animate .core {
    transform: scale(0);
    transform-origin: 50% 50%;
    transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1)
      calc(var(--delay) + 0.75s);
  }

  .animate:global(.is-in) .arc {
    stroke-dashoffset: var(--offset);
  }

  .animate:global(.is-in) .core {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate .arc {
      stroke-dashoffset: var(--offset);
      transition: none;
    }

    .animate .core {
      transform: scale(1);
      transition: none;
    }
  }
</style>
