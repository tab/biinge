---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
// Empty without SITE_URL, which leaves canonical and og:url relative on a local build
const site = import.meta.env.SITE ?? "";
// PNG, not the SVG source: the social platforms don't render SVG previews
const ogImage = `${site}${base}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
    <link
      rel="preload"
      href={`${base}fonts/archivo-latin-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="biinge" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script is:inline>
      (function () {
        // dark until the toggle saves light, whatever the system appearance
        var theme = "dark";
        try {
          if (localStorage.getItem("theme") === "light") theme = "light";
        } catch (_) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var root = document.documentElement;

        // The screenshots and recordings ship without a src, because two tags
        // with one hidden downloads both files. This picks the one the theme
        // actually shows, and runs again whenever the theme changes
        function paintScreens() {
          var dark = root.getAttribute("data-theme") === "dark";
          var screens = document.querySelectorAll("[data-screen]");
          for (var i = 0; i < screens.length; i++) {
            var el = screens[i];
            var wantsDark = el.getAttribute("data-fixed") === "dark" || dark;
            var next = wantsDark
              ? el.getAttribute("data-dark")
              : el.getAttribute("data-light");
            if (el.tagName === "VIDEO") {
              el.setAttribute(
                "poster",
                wantsDark
                  ? el.getAttribute("data-poster-dark")
                  : el.getAttribute("data-poster-light"),
              );
            }
            if (el.getAttribute("src") === next) continue;
            // a new src stops a playing clip, so it picks up again in the new theme
            var playing = el.tagName === "VIDEO" && !el.paused;
            el.setAttribute("src", next);
            if (playing) el.play().catch(function () {});
          }
        }

        paintScreens();

        // a recording loops only while it is on screen, and under reduced
        // motion stays on its poster (the preference can change mid-visit)
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        var recordings = document.querySelectorAll("video[data-recording]");
        var visible = new Set();
        var onScreen = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) visible.add(entry.target);
              else visible.delete(entry.target);
              if (entry.isIntersecting && !reduce.matches) {
                entry.target.play().catch(function () {});
              } else {
                entry.target.pause();
              }
            });
          },
          { threshold: 0.25 },
        );
        recordings.forEach(function (video) {
          onScreen.observe(video);
        });
        reduce.addEventListener("change", function () {
          recordings.forEach(function (video) {
            // load() stops the clip and shows its poster again, keeping the theme's src
            if (reduce.matches) video.load();
            else if (visible.has(video)) video.play().catch(function () {});
          });
        });

        var toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () {
            var next =
              root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            // the class eases the palette across, so the swap isn't a hard cut
            root.classList.add("theme-switching");
            root.setAttribute("data-theme", next);
            paintScreens();
            window.setTimeout(function () {
              root.classList.remove("theme-switching");
            }, 300);
            try {
              localStorage.setItem("theme", next);
            } catch (_) {}
          });
        }
      })();
    </script>
    <script>
      // the bar is invisible over the hero, and turns solid once you leave it
      const topbar = document.querySelector(".topbar");

      if (topbar) {
        const onScroll = () => {
          topbar.classList.toggle("is-stuck", window.scrollY > 24);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        function copyText(text) {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text);
          }
          var ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
          return Promise.resolve();
        }

        document.querySelectorAll(".copy-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const block = btn.closest(".code-ide");
            if (!block) return;
            const code = block.querySelector("code");
            if (!code) return;
            copyText(code.textContent || "").then(() => {
              btn.classList.add("copied");
              setTimeout(() => btn.classList.remove("copied"), 2000);
            });
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
