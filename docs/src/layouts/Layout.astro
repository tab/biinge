---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
// Empty without SITE_URL, which leaves canonical and og:url relative on a local build
const site = import.meta.env.SITE ?? "";
// PNG, not the SVG source: the social platforms don't render SVG previews
const ogImage = `${site}${base}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
    <link
      rel="preload"
      href={`${base}fonts/archivo-latin-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site}${Astro.url.pathname}`} />
    <meta property="og:site_name" content="biinge" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var theme =
          saved ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
        // the reveal styles only apply once this lands, so nothing hides without JS
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      const toggle = document.getElementById("theme-toggle");
      if (toggle) {
        toggle.addEventListener("click", () => {
          const current = document.documentElement.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (_) {}
        });
      }
    </script>
    <script>
      // the state badges fill themselves once, as their section arrives
      const rings = document.querySelectorAll(".ring.animate");

      if (rings.length) {
        const seen = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              seen.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -18% 0px", threshold: 0.5 },
        );

        rings.forEach((ring) => seen.observe(ring));
      }
    </script>
    <script>
      // sections lift into place once, as they arrive
      const revealed = document.querySelectorAll("[data-reveal]");

      if (revealed.length) {
        const arriving = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              arriving.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px" },
        );

        revealed.forEach((el) => arriving.observe(el));
      }

      // a looping phone only plays while it's on screen, so it costs nothing
      // to scroll past
      document.querySelectorAll("[data-loop]").forEach((loop) => {
        const playing = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            loop.classList.toggle("is-playing", entry.isIntersecting);
          });
        }, { threshold: 0.25 });

        playing.observe(loop);
      });

      // the bar is invisible over the hero, and turns solid once you leave it
      const topbar = document.querySelector(".topbar");

      if (topbar) {
        const onScroll = () => {
          topbar.classList.toggle("is-stuck", window.scrollY > 24);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        function copyText(text) {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text);
          }
          var ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          document.body.removeChild(ta);
          return Promise.resolve();
        }

        document.querySelectorAll(".copy-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const block = btn.closest(".code-ide");
            if (!block) return;
            const code = block.querySelector("code");
            if (!code) return;
            copyText(code.textContent || "").then(() => {
              btn.classList.add("copied");
              setTimeout(() => btn.classList.remove("copied"), 2000);
            });
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
