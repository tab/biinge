---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

// What the playground points at out of the box: the hosted API in a deployed build,
// a local server otherwise. Origin only, the endpoint paths carry their own /api/v1
const apiBaseURL = import.meta.env.PUBLIC_API_BASE_URL || "http://localhost:8080";

function esc(s: string): string {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

const tokenJson = esc(`{
  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6...",
  "refresh_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6..."
}`);
const liveJson = esc(`{ "result": "alive" }`);
const readyJson = esc(`{ "result": "ready" }`);
const movieListJson = esc(`{
  "data": [
    {
      "id": 693134,
      "title": "Dune: Part Two",
      "posterPath": "/czembW0Rk1Ke7lCJGahbOhdCLZ.jpg",
      "pinned": true,
      "state": "want"
    }
  ],
  "meta": { "page": 1, "per": 24, "total": 1 }
}`);
const upNextJson = esc(`{
  "episodes": [
    {
      "seriesId": 125988,
      "seriesTitle": "Silo",
      "seriesPosterPath": "/gMYZZvnkVNTqSVnVCphWbPXwWwb.jpg",
      "id": 7173957,
      "title": "Who Are You?",
      "seasonNumber": 3,
      "number": 1,
      "posterPath": "/nIvrv95n7gukebcCEUeZJDy9iEp.jpg",
      "overview": "Juliette wakes somewhere she was never meant to reach…",
      "runtime": 56,
      "rating": 6.6,
      "airDate": "2026-07-02"
    }
  ],
  "movies": [
    {
      "id": 786892,
      "title": "Furiosa: A Mad Max Saga",
      "posterPath": "/iADOJ8Zymht2JPMoy3R7xceZprc.jpg",
      "overview": "As the world falls, young Furiosa is snatched from the Green Place…",
      "runtime": 149,
      "rating": 7.4,
      "releaseDate": "2024-05-22"
    }
  ],
  "games": [
    {
      "id": 1942,
      "title": "The Witcher 3: Wild Hunt",
      "posterPath": "co1wyy",
      "overview": "A story-driven open world RPG set in a fantasy universe…",
      "runtime": 3000,
      "rating": 9.5,
      "releaseDate": "2015-05-19"
    }
  ]
}`);
const statsJson = esc(`{
  "period": "all",
  "movies": { "want": 131, "watched": 895, "minutes": 104760 },
  "series": { "want": 16, "watching": 75, "watched": 96 },
  "episodes": { "watched": 4213, "minutes": 168520 },
  "games": { "want": 12, "playing": 2, "played": 34, "minutes": 61200 },
  "activity": [
    { "date": "2025-01-01", "movieMinutes": 12480, "tvMinutes": 41320 },
    { "date": "2026-01-01", "movieMinutes": 9260, "tvMinutes": 33970 }
  ]
}`);

interface QueryParam {
  name: string;
  // prefilled when the endpoint needs a value to answer at all, empty otherwise
  value?: string;
  hint: string;
}

interface Endpoint {
  id: string;
  group: string;
  method: "GET" | "POST" | "PATCH" | "DELETE";
  path: string;
  desc: string;
  // a second paragraph, for the endpoints whose parameters need more than a clause
  note?: string;
  params?: QueryParam[];
  body?: string;
  resp?: string;
}

const paging: QueryParam[] = [
  { name: "page", hint: "1" },
  { name: "per", hint: "24" },
];

const endpoints: Endpoint[] = [
  { id: "get-live", group: "Health", method: "GET", path: "/live", desc: "Liveness probe. No authentication required.", resp: liveJson },
  { id: "get-ready", group: "Health", method: "GET", path: "/ready", desc: "Readiness probe — 503 until Postgres answers. No authentication required.", resp: readyJson },
  { id: "get-health", group: "Health", method: "GET", path: "/health", desc: "Plain-text heartbeat, answered by middleware ahead of the router. Accepts HEAD as well as GET. No authentication required.", resp: esc(".") },

  { id: "register", group: "Users", method: "POST", path: "/api/v1/users/registrations", desc: "Create a new account.", body: `{
  "login": "cinephile",
  "email": "you@example.com",
  "password": "your-password",
  "first_name": "Jane",
  "last_name": "Doe",
  "appearance": "dark"
}` },
  { id: "login", group: "Users", method: "POST", path: "/api/v1/users/sessions", desc: "Log in. After a successful login the playground copies the access token into the Token field above.", body: `{
  "email": "you@example.com",
  "password": "your-password"
}`, resp: tokenJson },
  { id: "refresh", group: "Users", method: "POST", path: "/api/v1/users/tokens", desc: "Exchange a refresh token for a new token pair.", body: `{
  "refresh_token": "<paste refresh token>"
}`, resp: tokenJson },

  { id: "me", group: "Account", method: "GET", path: "/api/v1/accounts/me", desc: "The authenticated user." },
  { id: "update-account", group: "Account", method: "PATCH", path: "/api/v1/accounts", desc: "Update profile and appearance preference.", body: `{
  "first_name": "Jane",
  "last_name": "Doe",
  "appearance": "dark"
}` },
  { id: "stats", group: "Account", method: "GET", path: "/api/v1/accounts/stats", desc: "Library counts, watch-time totals and watch activity for the selected period.", note: "week, month and year mean the current calendar week, month and year, not a rolling window. Inside one of them, want counts what was added rather than the whole list, and the watching and playing counts are omitted. Defaults to all.", params: [{ name: "period", hint: "week | month | year | all" }], resp: statsJson },

  { id: "movies-list", group: "Movies", method: "GET", path: "/api/v1/movies", desc: "Your movie library, one state at a time. type defaults to want.", params: [{ name: "type", hint: "want | watched" }, ...paging], resp: movieListJson },
  { id: "movies-create", group: "Movies", method: "POST", path: "/api/v1/movies", desc: "Add a movie to the library. id is the TMDB movie id.", body: `{
  "id": 693134,
  "title": "Dune: Part Two",
  "posterPath": "/czembW0Rk1Ke7lCJGahbOhdCLZ.jpg",
  "runtime": 167,
  "state": "want"
}` },
  { id: "movie-get", group: "Movies", method: "GET", path: "/api/v1/movies/{id}", desc: "Movie details, credits, and recommendations." },
  { id: "movie-update", group: "Movies", method: "PATCH", path: "/api/v1/movies/{id}", desc: "Change state or pin the movie.", body: `{
  "state": "watched",
  "pinned": true
}` },
  { id: "movie-delete", group: "Movies", method: "DELETE", path: "/api/v1/movies/{id}", desc: "Remove the movie from the library." },

  { id: "games-list", group: "Games", method: "GET", path: "/api/v1/games", desc: "Your game library, one state at a time. type defaults to want.", params: [{ name: "type", hint: "want | playing | played" }, ...paging] },
  { id: "games-create", group: "Games", method: "POST", path: "/api/v1/games", desc: "Add a game to the library. id is the IGDB game id, and posterPath is an IGDB cover image_id rather than a path.", body: `{
  "id": 1942,
  "title": "The Witcher 3: Wild Hunt",
  "posterPath": "co1wyy",
  "runtime": 3000,
  "state": "want"
}` },
  { id: "game-get", group: "Games", method: "GET", path: "/api/v1/games/{id}", desc: "Game details from IGDB, with similar games and IGDB's estimated time for a main playthrough and for 100% completion, both in minutes." },
  { id: "game-update", group: "Games", method: "PATCH", path: "/api/v1/games/{id}", desc: "Change state or pin the game.", body: `{
  "state": "played",
  "pinned": true
}` },
  { id: "game-delete", group: "Games", method: "DELETE", path: "/api/v1/games/{id}", desc: "Remove the game from the library." },

  { id: "series-list", group: "TV Series", method: "GET", path: "/api/v1/series", desc: "Your series library, one state at a time. type defaults to want.", params: [{ name: "type", hint: "want | watching | watched" }, ...paging] },
  { id: "series-create", group: "TV Series", method: "POST", path: "/api/v1/series", desc: "Add a show to the library. id is the TMDB series id.", note: "status is TMDB's own, and it matters: a show left at Returning Series never derives to watched, however many episodes are ticked.", body: `{
  "id": 95396,
  "title": "Severance",
  "posterPath": "/pPHpeI2X1qEd1CS1SeyrdhZ4qnT.jpg",
  "seasonsCount": 3,
  "episodesCount": 19,
  "status": "Returning Series",
  "state": "want"
}` },
  { id: "series-get", group: "TV Series", method: "GET", path: "/api/v1/series/{id}", desc: "Series details with seasons." },
  { id: "series-update", group: "TV Series", method: "PATCH", path: "/api/v1/series/{id}", desc: "Change state or pin the show.", body: `{
  "state": "watching",
  "pinned": true
}` },
  { id: "series-delete", group: "TV Series", method: "DELETE", path: "/api/v1/series/{id}", desc: "Remove the show from the library." },
  { id: "season-get", group: "TV Series", method: "GET", path: "/api/v1/series/{id}/season/{seasonNumber}", desc: "Season details and episodes." },
  { id: "episode-get", group: "TV Series", method: "GET", path: "/api/v1/series/{id}/season/{seasonNumber}/episode/{episodeNumber}", desc: "Single episode details." },

  { id: "progress-get", group: "Progress", method: "GET", path: "/api/v1/series/{id}/progress", desc: "Watched seasons and episodes for a show." },
  { id: "show-watched", group: "Progress", method: "POST", path: "/api/v1/series/{id}/watched", desc: "Mark a show watched. Ids come from the URL, and the body carries the rows to write.", note: "Only the seasons and episodes you list are recorded, so a body without them marks nothing. The example lists two episodes of season one; a real client sends all nine, and every other season too.", body: `{
  "series": {
    "title": "Severance",
    "posterPath": "/pPHpeI2X1qEd1CS1SeyrdhZ4qnT.jpg",
    "seasonsCount": 3,
    "episodesCount": 19,
    "status": "Returning Series"
  },
  "seasons": [
    {
      "id": 135726,
      "title": "Season 1",
      "number": 1,
      "episodesCount": 9,
      "episodes": [
        { "id": 1982925, "title": "Good News About Hell", "posterPath": "/sP3GZe9j7BY3CAyZGFuZxxnGpN1.jpg", "runtime": 57, "airDate": "2022-02-17" },
        { "id": 3396429, "title": "Half Loop", "posterPath": "/wIQP0P2tyE7VRIN3xR8Efq7UgKt.jpg", "runtime": 53, "airDate": "2022-02-17" }
      ]
    }
  ]
}` },
  { id: "show-unwatched", group: "Progress", method: "DELETE", path: "/api/v1/series/{id}/watched", desc: "Unmark the whole show, dropping every season and episode recorded for it." },
  { id: "season-watched", group: "Progress", method: "POST", path: "/api/v1/series/{id}/seasons/{seasonId}/watched", desc: "Mark a season watched.", note: "The episodes array is what actually gets recorded. Send the season's episodes in it — without them the show ends up with no watched episodes, and nothing is tracked.", body: `{
  "series": {
    "title": "Severance",
    "posterPath": "/pPHpeI2X1qEd1CS1SeyrdhZ4qnT.jpg",
    "seasonsCount": 3,
    "episodesCount": 19,
    "status": "Returning Series"
  },
  "season": { "title": "Season 1", "number": 1, "episodesCount": 9 },
  "episodes": [
    { "id": 1982925, "title": "Good News About Hell", "posterPath": "/sP3GZe9j7BY3CAyZGFuZxxnGpN1.jpg", "runtime": 57, "airDate": "2022-02-17" },
    { "id": 3396429, "title": "Half Loop", "posterPath": "/wIQP0P2tyE7VRIN3xR8Efq7UgKt.jpg", "runtime": 53, "airDate": "2022-02-17" }
  ]
}` },
  { id: "season-unwatched", group: "Progress", method: "DELETE", path: "/api/v1/series/{id}/seasons/{seasonId}/watched", desc: "Unmark a season and its episodes." },
  { id: "episode-watched", group: "Progress", method: "POST", path: "/api/v1/series/{id}/seasons/{seasonId}/episodes/{episodeId}/watched", desc: "Mark an episode as watched.", note: "The show and season rows are created from this body if they don't exist yet, so send their metadata alongside the episode.", body: `{
  "series": {
    "title": "Severance",
    "posterPath": "/pPHpeI2X1qEd1CS1SeyrdhZ4qnT.jpg",
    "seasonsCount": 3,
    "episodesCount": 19,
    "status": "Returning Series"
  },
  "season": { "title": "Season 1", "number": 1, "episodesCount": 9 },
  "episode": {
    "title": "Good News About Hell",
    "posterPath": "/sP3GZe9j7BY3CAyZGFuZxxnGpN1.jpg",
    "runtime": 57,
    "airDate": "2022-02-17"
  }
}` },
  { id: "episode-unwatched", group: "Progress", method: "DELETE", path: "/api/v1/series/{id}/seasons/{seasonId}/episodes/{episodeId}/watched", desc: "Unmark an episode." },

  { id: "search-movies", group: "Search & Trending", method: "GET", path: "/api/v1/search/movies", desc: "Search movies. query is required.", params: [{ name: "query", value: "dune", hint: "search terms" }, { name: "page", hint: "1" }] },
  { id: "search-series", group: "Search & Trending", method: "GET", path: "/api/v1/search/series", desc: "Search TV shows. query is required.", params: [{ name: "query", value: "silo", hint: "search terms" }, { name: "page", hint: "1" }] },
  { id: "search-games", group: "Search & Trending", method: "GET", path: "/api/v1/search/games", desc: "Search PlayStation 5 and PlayStation 4 games. query is required.", params: [{ name: "query", value: "witcher", hint: "search terms" }, { name: "page", hint: "1" }] },
  { id: "search-people", group: "Search & Trending", method: "GET", path: "/api/v1/search/people", desc: "Search people. query is required.", params: [{ name: "query", value: "villeneuve", hint: "search terms" }, { name: "page", hint: "1" }] },
  { id: "trending-movies", group: "Search & Trending", method: "GET", path: "/api/v1/trending/movies", desc: "Trending movies.", params: [{ name: "page", hint: "1" }] },
  { id: "trending-series", group: "Search & Trending", method: "GET", path: "/api/v1/trending/series", desc: "Trending TV shows.", params: [{ name: "page", hint: "1" }] },
  { id: "trending-games", group: "Search & Trending", method: "GET", path: "/api/v1/trending/games", desc: "Trending PlayStation games.", params: [{ name: "page", hint: "1" }] },
  { id: "trending-people", group: "Search & Trending", method: "GET", path: "/api/v1/trending/people", desc: "Trending people.", params: [{ name: "page", hint: "1" }] },

  { id: "up-next", group: "Up Next", method: "GET", path: "/api/v1/up-next", desc: "The next aired episode you haven't watched of each pinned show you're watching, plus released movies and games from your pinned want lists.", resp: upNextJson },

  { id: "person-get", group: "People", method: "GET", path: "/api/v1/people/{id}", desc: "Person details and notable credits." },
];

const groups = [...new Set(endpoints.map((e) => e.group))];
const pathDefaults: Record<string, string> = { seasonNumber: "1", episodeNumber: "1" };

// {id} is a different provider's id depending on the route, and a generic hint is
// how you end up sending a TMDB id to a game endpoint
const idHints: Record<string, string> = {
  Movies: "TMDB movie id",
  "TV Series": "TMDB series id",
  Progress: "TMDB series id",
  Games: "IGDB game id",
  People: "TMDB person id",
};
const pathHints: Record<string, string> = {
  seasonId: "TMDB season id", episodeId: "TMDB episode id",
  seasonNumber: "season number", episodeNumber: "episode number",
};
const hintFor = (group: string, param: string) =>
  param === "id" ? (idHints[group] ?? "id") : (pathHints[param] ?? param);

const pathParamsOf = (path: string) => [...path.matchAll(/\{(\w+)\}/g)].map((m) => m[1]);
const short = (path: string) => path.replace("/api/v1", "") || "/";
---

<Layout
  title="API Reference - biinge"
  description="Interactive REST API reference for the biinge backend, with a playground that sends every request to your own server."
>
  <Header wide />
  <div class="api-layout">
    <aside class="api-sidebar">
      <div class="sb-title">API Reference</div>
      <nav class="api-nav">
        <a href="#overview" class="api-link"><span class="path">Overview</span></a>
        {groups.map((g) => (
          <>
            <div class="nav-section">{g}</div>
            {endpoints.filter((e) => e.group === g).map((e) => (
              <a href={`#${e.id}`} class="api-link">
                <span class:list={["mb", e.method.toLowerCase()]}>{e.method}</span>
                <span class="path">{short(e.path)}</span>
              </a>
            ))}
          </>
        ))}
        <div class="nav-section">Reference</div>
        <a href="#errors" class="api-link"><span class="path">Errors</span></a>
      </nav>
      <div class="sb-foot">
        <a href="https://github.com/tab/biinge/blob/master/api/api/swagger.yaml" target="_blank" rel="noopener" class="spec-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          OpenAPI spec
        </a>
      </div>
    </aside>

    <main class="api-main">
      <section class="api-intro" id="overview">
        <div class="eyebrow-label">REST API</div>
        <h1>API Reference</h1>
        <p class="intro-lead">
          The iOS app runs on this JSON API, and so can anything else you write.
          Point the playground at your own server to send a real request to every
          endpoint below.
        </p>

        <div class="conn">
          <div class="conn-doc">
            <p>
              Registration, login and token refresh are public. Every other
              <code>/api/v1</code> endpoint needs an
              <code>Authorization: Bearer</code> token — run
              <a href="#login">Login</a> below and the playground copies the
              access token into the field here.
            </p>
            <p class="conn-note">
              Requests go straight from your browser, so your server's CORS
              policy (<code>CLIENT_URL</code>) has to allow this origin. Use
              HTTPS for a remote server: this page is served over HTTPS, and
              browsers block plain HTTP requests from it. Loopback addresses are
              the exception, though the details vary by browser.
            </p>
          </div>
          <div class="conn-fields">
            <div class="pg-row">
              <label class="pg-label">Base URL</label>
              <input type="text" id="pg-base" value={apiBaseURL} class="pg-input" />
            </div>
            <div class="pg-row">
              <label class="pg-label">Token</label>
              <input type="text" id="pg-token" value="" placeholder="access_token" class="pg-input" />
            </div>
          </div>
        </div>
      </section>

      {endpoints.map((ep, i) => {
        const pathParams = pathParamsOf(ep.path);
        return (
          <>
            {(i === 0 || endpoints[i - 1].group !== ep.group) && (
              <h2 class="group-heading">{ep.group}</h2>
            )}
            <section class="endpoint" id={ep.id}>
              <div class="ep-head">
                <span class:list={["mb", ep.method.toLowerCase()]}>{ep.method}</span>
                <code class="ep-path">{ep.path}</code>
              </div>
              <div class="two-col">
                <div class="col-doc">
                  <p>{ep.desc}</p>
                  {ep.note && <p>{ep.note}</p>}
                  {ep.resp && (
                    <div class="resp-block">
                      <div class="resp-label">Example response <span class="ok">200</span></div>
                      <pre><code set:html={ep.resp} /></pre>
                    </div>
                  )}
                </div>
                <div class="col-play">
                  <div class="pg" data-method={ep.method} data-path={ep.path}>
                    {pathParams.map((p) => (
                      <div class="pg-row">
                        <label class="pg-label">{p}</label>
                        <input type="text" class="pg-input pg-param" data-param={p} value={pathDefaults[p] ?? ""} placeholder={hintFor(ep.group, p)} />
                      </div>
                    ))}
                    {(ep.params ?? []).map((p) => (
                      <div class="pg-row">
                        <label class="pg-label">{p.name}</label>
                        <input type="text" class="pg-input pg-query" data-query={p.name} value={p.value ?? ""} placeholder={p.hint} />
                      </div>
                    ))}
                    {ep.body && (
                      <textarea class="pg-input pg-body" spellcheck="false" rows="5">{ep.body}</textarea>
                    )}
                    <button class="pg-send">
                      <span class:list={["mt", ep.method.toLowerCase()]}>{ep.method}</span>
                      Send
                    </button>
                    <div class="pg-result" style="display:none">
                      <div class="pg-rhead">
                        <span class="pg-status"></span>
                        <span class="pg-time"></span>
                      </div>
                      <pre><code class="pg-out"></code></pre>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </>
        );
      })}

      <h2 class="group-heading">Reference</h2>
      <section class="endpoint" id="errors">
        <div class="ep-head">
          <span class="mb err">ERR</span>
          <code class="ep-path">Common errors</code>
        </div>
        <div class="two-col">
          <div class="col-doc col-full">
            <p>
              A failure inside a controller returns a JSON body with an
              <code>error</code> message and one of these status codes. Responses
              from the middleware around it — rate limiting, an unmatched route —
              are plain text.
            </p>
            <table>
              <thead><tr><th>Status</th><th>Meaning</th><th>When</th></tr></thead>
              <tbody>
                <tr><td><code>400</code></td><td>Bad Request</td><td>Malformed JSON, an unparseable id, or a body that fails validation</td></tr>
                <tr><td><code>401</code></td><td>Unauthorized</td><td>Missing, invalid or expired access token, or wrong login credentials</td></tr>
                <tr><td><code>409</code></td><td>Conflict</td><td>Registering a login or email that is already taken</td></tr>
                <tr><td><code>422</code></td><td>Unprocessable Entity</td><td>The request was well formed but the work failed — including a title the upstream provider doesn't have</td></tr>
                <tr><td><code>429</code></td><td>Too Many Requests</td><td>More than 5 requests a minute per IP to the public <code>/users</code> routes, or 120 a minute per user everywhere else</td></tr>
                <tr><td><code>500</code></td><td>Internal Server Error</td><td>Registration failed for a reason the API won't detail</td></tr>
                <tr><td><code>503</code></td><td>Service Unavailable</td><td>A dependency is unreachable, from <code>/ready</code> or from the auth middleware</td></tr>
              </tbody>
            </table>
            <p class="errors-note">
              There is no <code>404</code>: a title that isn't in your library, or
              that TMDB and IGDB can't resolve, comes back as <code>422</code>.
            </p>
          </div>
        </div>
      </section>
    </main>
  </div>
  <Footer />
</Layout>

<script>
  // --- interactive playground ---
  document.querySelectorAll(".pg-send").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pg = btn.closest(".pg") as HTMLElement;
      const base = (document.getElementById("pg-base") as HTMLInputElement).value.replace(/\/$/, "");
      const token = (document.getElementById("pg-token") as HTMLInputElement).value.trim();
      const method = pg.dataset.method!;

      let path = pg.dataset.path!;
      pg.querySelectorAll(".pg-param").forEach((el) => {
        const inp = el as HTMLInputElement;
        const val = inp.value.trim();
        if (val) path = path.replace(`{${inp.dataset.param}}`, encodeURIComponent(val));
      });

      const query = new URLSearchParams();
      pg.querySelectorAll(".pg-query").forEach((el) => {
        const inp = el as HTMLInputElement;
        const val = inp.value.trim();
        if (val) query.set(inp.dataset.query!, val);
      });

      const qs = query.toString();
      const url = base + path + (qs ? `?${qs}` : "");
      const headers: Record<string, string> = {};
      if (token) headers["Authorization"] = `Bearer ${token}`;

      let body: string | undefined;
      const bodyEl = pg.querySelector(".pg-body") as HTMLTextAreaElement | null;
      if (bodyEl && bodyEl.value.trim()) {
        headers["Content-Type"] = "application/json";
        body = bodyEl.value;
      }

      const resultEl = pg.querySelector(".pg-result") as HTMLElement;
      const statusEl = pg.querySelector(".pg-status") as HTMLElement;
      const timeEl = pg.querySelector(".pg-time") as HTMLElement;
      const outEl = pg.querySelector(".pg-out") as HTMLElement;

      resultEl.style.display = "";
      statusEl.textContent = "Sending…";
      statusEl.className = "pg-status";
      timeEl.textContent = "";
      outEl.textContent = "";

      const start = performance.now();
      try {
        const res = await fetch(url, { method, headers, body });
        const elapsed = Math.round(performance.now() - start);
        const text = await res.text();
        let parsed: any = null;
        let pretty = text;
        try { parsed = JSON.parse(text); pretty = JSON.stringify(parsed, null, 2); } catch (_) {}

        statusEl.textContent = `${res.status} ${res.statusText}`;
        statusEl.className = `pg-status ${res.ok ? "ok" : "err"}`;
        timeEl.textContent = `${elapsed}ms`;
        outEl.textContent = pretty;

        // convenience: capture the token from a successful login
        if (res.ok && parsed && parsed.access_token) {
          (document.getElementById("pg-token") as HTMLInputElement).value = parsed.access_token;
        }
      } catch (err: any) {
        const elapsed = Math.round(performance.now() - start);
        statusEl.textContent = "Network error";
        statusEl.className = "pg-status err";
        timeEl.textContent = `${elapsed}ms`;
        outEl.textContent = (err && err.message ? err.message : "Request failed") +
          "\n\nIf the server is running, check the Base URL and its CORS settings.";
      }
    });
  });

  // --- sidebar scrollspy ---
  const links = document.querySelectorAll(".api-link");
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          links.forEach((l) => l.classList.toggle("active", l.getAttribute("href") === `#${id}`));
        }
      });
    },
    { rootMargin: "-70px 0px -70% 0px" }
  );
  document.querySelectorAll(".endpoint, .api-intro").forEach((s) => spy.observe(s));
</script>

