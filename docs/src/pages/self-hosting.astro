---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CodeBlock from "../components/CodeBlock.astro";

const clone = `git clone https://github.com/tab/biinge.git
cd biinge`;

const env = `# api/.env.development.local — gitignored, never commit it
TMDB_API_READ_ACCESS_TOKEN=<your TMDB v4 read token>
IGDB_CLIENT_ID=<your Twitch app client id>
IGDB_CLIENT_SECRET=<your Twitch app client secret>
JWT_SECRET_KEY=<32+ random bytes>`;

const stack = `# 1. datastores first
docker compose up -d database redis

# 2. apply migrations (needs goose installed)
make -C api db:migrate

# 3. then the API, on :8080
docker compose up -d api`;

const app = `# compile the app against your API
make -C ios build`;

const config = [
  { name: "GO_ENV", purpose: "Selects the environment file and validation rules; defaults to development" },
  { name: "APP_ADDRESS", purpose: "Address and port the API listens on, such as 0.0.0.0:8080" },
  { name: "TMDB_API_READ_ACCESS_TOKEN", purpose: "TMDB v4 read token for movie and TV search, details and trending" },
  { name: "IGDB_CLIENT_ID / IGDB_CLIENT_SECRET", purpose: "Twitch application credentials used to access IGDB game data; required outside development" },
  { name: "DATABASE_DSN", purpose: "Postgres connection string" },
  { name: "REDIS_URL", purpose: "Redis URL for the metadata cache; leave it unset to run without caching" },
  { name: "JWT_SECRET_KEY", purpose: "Signs and verifies access tokens; must be at least 32 bytes outside development" },
  { name: "CLIENT_URL", purpose: "Adds an HTTPS client origin to the API's CORS allowlist" },
  { name: "WORKER_SYNC_ENABLED / WORKER_SYNC_INTERVAL", purpose: "Controls the background TMDB refresh worker and how often it runs" },
  { name: "SENTRY_DSN", purpose: "Error reporting (optional)" },
];
---

<Layout
  title="Self-hosting — biinge"
  description="Run the biinge API with Docker and connect the native iOS app to your own server."
>
  <Header />
  <main class="page">
    <div class="container">
      <div class="page-head">
        <p class="eyebrow-label">Self-hosting</p>
        <h1>Run Biinge on your own server.</h1>
        <p class="lead">
          Run the Go API with PostgreSQL and Redis, then connect the native iOS
          app. The steps below create a local development stack; review the
          <a href="#production">production checklist</a> before exposing it to
          the internet.
        </p>
      </div>

      <div class="prereq">
        <h2>Before you start</h2>
        <ul>
          <li><strong>Docker with Compose</strong> — runs Postgres, Redis and the API</li>
          <li>
            A free <a href="https://developer.themoviedb.org" target="_blank" rel="noopener">TMDB</a>
            v4 read access token — provides movie and TV search, details and trending
          </li>
          <li>
            A <a href="https://dev.twitch.tv/console/apps" target="_blank" rel="noopener">Twitch application</a>
            client ID and secret — gives the API access to
            <a href="https://api-docs.igdb.com" target="_blank" rel="noopener">IGDB</a>
            game data
          </li>
          <li>
            <a href="https://github.com/pressly/goose" target="_blank" rel="noopener">goose</a>
            — applies database migrations
          </li>
          <li><strong>Xcode 26</strong> — to build the iOS app</li>
        </ul>
      </div>

      <ol class="steps">
        <li class="step">
          <div class="step-head"><span class="num">1</span><h3>Clone the repo</h3></div>
          <CodeBlock code={clone} label="bash" />
        </li>

        <li class="step">
          <div class="step-head"><span class="num">2</span><h3>Add your API keys</h3></div>
          <p>
            Create <code>api/.env.development.local</code> for your credentials.
            The file is gitignored and loaded after the committed development
            defaults, whether the API runs in Docker or directly.
          </p>
          <CodeBlock code={env} label="env" />
          <p class="note">
            In development, missing IGDB credentials leave saved games available
            but return no game search results. Other environments will not start
            without them.
          </p>
        </li>

        <li class="step">
          <div class="step-head"><span class="num">3</span><h3>Bring up the stack</h3></div>
          <CodeBlock code={stack} label="bash" />
          <p class="note">
            To run only the API outside Docker, use
            <code>cd api && GO_ENV=development go run ./cmd/biinge</code>. If you
            have Fuku installed, <code>fuku up</code> starts it and waits on
            <code>/ready</code>. The health endpoints are <code>GET /live</code>
            for liveness and <code>GET /ready</code> for readiness.
          </p>
        </li>

        <li class="step">
          <div class="step-head"><span class="num">4</span><h3>Connect and build the app</h3></div>
          <p>
            Open <code>ios/Biinge.xcodeproj</code> in Xcode 26 and run it on a
            simulator or your own device. To check it compiles without leaving
            the terminal:
          </p>
          <CodeBlock code={app} label="bash" />
          <p class="note">
            The app targets <code>http://localhost:8080/api/v1</code> by default.
            To point it somewhere else, copy <code>ios/.env.example</code> to
            <code>ios/.env</code> and set <code>API_BASE_URL</code> — on a real
            device that has to be a host the phone can reach, not localhost.
          </p>
        </li>
      </ol>

      <div class="config">
        <h2>Configuration</h2>
        <p class="config-lead">
          These are the settings you are most likely to change. The complete
          development defaults live in <code>api/.env.development</code>.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Variable</th><th>Purpose</th></tr>
            </thead>
            <tbody>
              {config.map((row) => (
                <tr>
                  <td><code>{row.name}</code></td>
                  <td>{row.purpose}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="config" id="production">
        <h2>Before exposing the API</h2>
        <p class="config-lead">
          The Compose stack above is for local development. It uses default
          database credentials, publishes the database and Redis ports, and
          serves the API over plain HTTP. A public deployment needs at least:
        </p>
        <ul class="prod-list">
          <li>
            <code>GO_ENV=production</code>, complete production environment
            values, a random <code>JWT_SECRET_KEY</code> of at least 32 bytes,
            and a unique PostgreSQL password
          </li>
          <li>
            A reverse proxy terminating TLS in front of the API; if a browser
            client calls it, add that HTTPS origin to <code>CLIENT_URL</code>
          </li>
          <li>
            The database and Redis ports unpublished, reachable only on the
            Compose network
          </li>
          <li>Backups of the Postgres volume, and a plan for applying migrations on upgrade</li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding: 80px 0 120px;
  }

  .page-head {
    max-width: 880px;
    margin-bottom: 64px;
  }

  .prereq {
    max-width: 900px;
    padding: 30px 34px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elevated);
    margin-bottom: 72px;
  }

  .prereq h2 {
    font-family: var(--display);
    font-variation-settings: "wdth" 100, "wght" 610;
    font-weight: 610;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 14px;
  }

  .prereq ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prereq li {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-muted);
    padding-left: 20px;
    position: relative;
  }

  .prereq li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--accent);
  }

  .prereq strong {
    color: var(--text);
    font-weight: 600;
  }

  .steps {
    list-style: none;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
  }

  .step h3 {
    font-family: var(--display);
    font-variation-settings: "wdth" 100, "wght" 610;
    font-weight: 610;
    font-size: 1.45rem;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .step p {
    max-width: 76ch;
    font-size: 1.03rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .step .note {
    margin-top: 14px;
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  .step code,
  .config code {
    font-family: var(--mono);
    font-size: 0.82em;
    color: var(--text);
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 5px;
    padding: 1px 6px;
  }

  .config {
    max-width: 900px;
    margin-top: 96px;
  }

  .config h2 {
    font-family: var(--display);
    font-variation-settings: "wdth" 100, "wght" 620;
    font-weight: 620;
    font-size: 1.8rem;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 10px;
  }

  .config-lead {
    max-width: 76ch;
    font-size: 1.03rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .prod-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .prod-list li {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text-muted);
    padding-left: 18px;
    position: relative;
  }

  .prod-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  th {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 550;
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  td {
    color: var(--text-muted);
  }

  td code {
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .page {
      padding: 48px 0 64px;
    }

    .prereq {
      padding: 24px;
      margin-bottom: 56px;
    }

    .steps {
      gap: 44px;
    }

    td code {
      white-space: normal;
    }
  }
</style>
