# Copy this to .env (gitignored) and set API_BASE_URL for the build you want.
# Scripts/inject-env.sh injects it into Info.plist at build time and Config.swift
# reads it at runtime. Edit .env by hand to switch environments.
#
#   Local dev:  http://localhost:8080/api/v1   (on a device use your Mac's LAN IP)
#   Production: https://biingeapp.com/api/v1
API_BASE_URL=http://localhost:8080/api/v1
