# Copy this to .env (gitignored) and set the values for the build you want.
# Scripts/inject-env.sh injects these into Info.plist at build time and
# Config.swift reads them at runtime. Edit .env by hand to switch environments.
#
#   Local dev:  http://localhost:8080/api/v1   (on a device use your Mac's LAN IP)
#   Production: https://api.example.com/api/v1   (whatever host your API is on)
API_BASE_URL=http://localhost:8080/api/v1

# Crash and error reporting. The DSN is a public, write-only key (it ships in the
# app binary), so it is safe to keep here. Flip SENTRY_ENABLED to true to turn it
# on; the build's environment tag is development for Debug, production for Release.
SENTRY_DSN=SECRET
SENTRY_ENABLED=false
