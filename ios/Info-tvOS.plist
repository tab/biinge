	<string>$(API_BASE_URL)</string>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SENTRY_ENABLED</key>
	<string>$(SENTRY_ENABLED)</string>
	<key>NSAppTransportSecurity</key>
